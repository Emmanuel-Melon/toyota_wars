{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "pnpm run dev:api",
    "dev:api": "nodemon --exec tsx src/server.ts",
    "openapi:emit": "tsx src/scripts/emit-openapi.ts",
    "build": "tsc -b && tsc-alias",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "drizzle:push": "pnpm exec drizzle-kit push",
    "drizzle:generate": "pnpm exec drizzle-kit generate",
    "drizzle:migrate": "pnpm exec drizzle-kit migrate",
    "drizzle:migrate:test": "dotenv -e .env.test -- pnpm exec drizzle-kit migrate",
    "drizzle:studio": "pnpm exec drizzle-kit studio",
    "drizzle:drop": "pnpm exec drizzle-kit drop",
    "db:reset": "tsx src/lib/drizzle/scripts/drizzle.reset.ts && pnpm exec drizzle-kit migrate",
    "seed": "tsx src/lib/drizzle/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.1",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "express-rate-limit": "^8.5.1",
    "glob": "^13.0.3",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  }
}
