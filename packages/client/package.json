{
  "name": "@toyota/client",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "generate:types": "openapi-typescript ../../apps/server/openapi.json -o src/api/generated/api.types.ts",
    "generate:types:remote": "openapi-typescript ${API_BASE_URL:-http://localhost:3000}/api-docs.json -o src/api/generated/api.types.ts",
    "check-types": "tsc --noEmit",
    "format": "prettier --write src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Typed API client for the Toyota Wars server",
  "dependencies": {
    "@sentry/react": "^10.53.1",
    "axios": "^1.15.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3"
  }
}
